# Copy this file to .env.local and fill in your own values.
#
# These are read by the SERVER only (the dev middleware in vite.config.ts, and
# the serverless function in api/identify.js). They are never exposed to the
# browser and never end up in the production bundle.
#
# Note the absence of a VITE_ prefix — that is deliberate. Vite inlines any
# VITE_* variable into the client bundle at build time, which would publish
# your secret key to anyone who opened devtools.
#
# Get these free (no card) from https://www.acrcloud.com:
#   Audio & Video Recognition -> create project
#   Audio Source: Recorded Audio      Audio Engine: Audio Fingerprinting

ACR_HOST=identify-eu-west-1.acrcloud.com
ACR_ACCESS_KEY=your-access-key
ACR_ACCESS_SECRET=your-secret-key
